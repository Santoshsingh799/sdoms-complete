PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/sdoms?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CLIENT_URL="http://localhost:5173"
# SMS: "dev" prints SMS in console; "msg91" or "twilio" for real sending
SMS_PROVIDER="dev"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Secret used to sign QR verification IDs and approval tokens
QR_SIGNING_SECRET="change-me-too"
GUARDIAN_LINK_EXPIRY_HOURS=24
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
